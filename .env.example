# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Node Environment
NODE_ENV=production

# Database Configuration
POSTGRES_USER=rgpapp
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=rgpdb

# Database Host Configuration
# For development with external DB: host.docker.internal
# For VPS production with an existing Postgres container:
# set DB_HOST to the reachable container hostname or VPS-local DB address
DB_HOST=rgp-db
DB_PORT=5432

# Logging
LOG_SQL=false
REQUEST_TIMING_ENABLED=false
REQUEST_TIMING_LOG_MIN_MS=0

# Stock/sales listings exclude batches expiring within this many days (minimum and default: 0)
EXPIRY_THRESHOLD_DAYS=0

# File Upload Configuration
FILEUPLOAD_LOCATION=/app/upload
FILEUPOAD_SIZE_LIMIT=512000

# JWT Configuration
JWT_KEY=your_jwt_secret_key_here
JWT_EXPIRES=24h

# API Configuration
API_PORT=3000

# Frontend Configuration
FRONTEND_PORT=80

# Volume Configuration
UPLOADS_PATH=~/uploads
