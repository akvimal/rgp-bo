# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Node Environment
NODE_ENV=production

# Database Configuration
POSTGRES_USER=rgpapp
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=rgpdb

# Database Host Configuration
# For development with external DB: host.docker.internal
# For VPS production with an existing Postgres container:
# set DB_HOST to the reachable container hostname or VPS-local DB address
DB_HOST=rgp-db
DB_PORT=5432

# Logging
LOG_SQL=false
REQUEST_TIMING_ENABLED=false
REQUEST_TIMING_LOG_MIN_MS=0

# File Upload Configuration
FILEUPLOAD_LOCATION=/app/upload
# largest upload in bytes (default 10 MB); the web server (nginx) allows 12 MB
FILEUPLOAD_SIZE_LIMIT=10485760
# GST rates (percent) offered for an invoice line when an invoice copy is read; comma separated
GST_RATES=0,5,12,18
FILEUPOAD_SIZE_LIMIT=512000

# JWT Configuration
JWT_KEY=your_jwt_secret_key_here
JWT_EXPIRES=24h

# API Configuration
API_PORT=3000

# Frontend Configuration
FRONTEND_PORT=80

# Volume Configuration
UPLOADS_PATH=~/uploads

# Telegram notifications (BotFather token; chat ids are set per store in the back office)
TELEGRAM_BOT_TOKEN=

# Settings > Alerts, "Describe an alert": a sentence is turned into a draft rule by one call to a language model.
# Leave both keys empty to switch the box off (the form still works).
# OpenRouter: any model it offers that can call tools; the owner picks one under "Describe an alert".
OPENROUTER_API_KEY=
# AI_MODEL=              default model (an OpenRouter id such as vendor/model-name) until the owner chooses one
# AI_ALLOWED_MODELS=     limit the choices: comma separated ids, a trailing * allowed (e.g. anthropic/*,openai/*)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Or a direct Anthropic key (one fixed model, no choice):
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# AI_PROVIDER=openrouter|anthropic    only needed when both keys are set (OpenRouter wins otherwise)
