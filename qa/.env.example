# Copy to qa/.env and adjust if your local stack differs.

# Frontend (Playwright baseURL) — docker frontend, remapped off the occupied :8000
QA_BASE_URL=http://localhost:8100

# API base for the seed generator and metrics (api container, host-mapped)
QA_API_URL=http://localhost:3000

# Postgres (host-mapped) for schema verification, pg_stat_statements, cross-store SQL
QA_DB_URL=postgresql://rgpapp:r9pAdmin7@localhost:5432/rgpdb

# Seed accounts (from sql/ddl/006_dev_test_data.sql). Password verified = admin123
QA_ADMIN_PASS=admin123

# realistic = moderate volume (~800 products, ~150 customers, ~4wk sales); small = fast CI
QA_SEED_PROFILE=realistic

# Compose project name (scripts/_env.sh builds the -f file list itself)
QA_COMPOSE_PROJECT=rgp-bo
