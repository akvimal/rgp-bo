# The new version beside the live one (docker-compose.beta.yml). Copy to .env.beta (git-ignored) and fill in.
# This file has its OWN database and its OWN keys: never copy the live database password or JWT key here.

POSTGRES_USER=rgpapp
# a new password, for the beta database only
POSTGRES_PASSWORD=
# the database the live dump is loaded into
POSTGRES_DB=rgpbeta

# a key of its own, so a login token from the live system is not accepted here (and the other way round)
JWT_KEY=
JWT_EXPIRES=24h

# the port the beta is reached on (put your web server or proxy in front of it); the live system keeps its own
BETA_PORT=8080
# 127.0.0.1 when a proxy (Caddy) on the same server fronts the beta, so the port is not open to the internet
BETA_BIND=0.0.0.0
# The docker network the proxy is on (see docker-compose.beta.edge.yml). Leave empty if there is none.
BETA_EDGE_NETWORK=

TZ=Asia/Kolkata
GST_RATES=0,5,12,18

# Leave these empty: the copy holds the live customers and staff, and nothing should be sent to them from it.
# For a test, give it a bot of its own (a different token from the live one) and a test group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
APP_BASE_URL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
